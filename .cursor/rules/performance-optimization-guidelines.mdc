## 📱 Native-Specific Optimizations

### 1. React Native Animation Optimization

```tsx
// Using react-native-reanimated for UI thread animations
import Animated, {
  useSharedValue,
  useAnimatedStyle,
  withSpring
} from 'react-native-reanimated';

function AnimatedComponent() {
  // Values shared between JS and UI thread
  const offset = useSharedValue(0);
  
  // Style calculated on the UI thread
  const animatedStyles = useAnimatedStyle(() => {
    return {
      transform: [{ translateX: offset.value }]
    };
  });
  
  const handlePress = () => {
    // Run on UI thread without blocking JS
    offset.value = withSpring(100);
  };
  
  return (
    <Pressable onPress={handlePress}>
      <Animated.View style={[styles.box, animatedStyles]} />
    </Pressable>
  );
}
```

### 2. Native Asset and Memory Management

```tsx
// Image optimization
import FastImage from 'react-native-fast-image';

function OptimizedImageList({ products }) {
  // Preload critical images
  useEffect(() => {
    const uris = products.slice(0, 5).map(p => ({ uri: p.image }));
    FastImage.preload(uris);
  }, [products]);
  
  return (
    <FlatList
      data={products}
      renderItem={({ item }) => (
        <FastImage
          style={styles.productImage}
          source={{ uri: item.image }}
          resizeMode={FastImage.resizeMode.cover}
        />
      )}
      // Remove hidden items from memory
      removeClippedSubviews={true}
      // Unload images on scroll
      onEndReachedThreshold={0.5}
    />
  );
}

// Memory leak prevention
function ComponentWithCleanup() {
  useEffect(() => {
    const subscription = someService.subscribe();
    // Important: Clean up to prevent memory leaks
    return () => {
      subscription.unsubscribe();
    };
  }, []);
}
```

### 3. Native Navigation Optimization

```tsx
// Optimize screen transitions
import { NavigationContainer } from '@react-navigation/native';
import { createStackNavigator, TransitionPresets } from '@react-navigation/stack';

const Stack = createStackNavigator();

function AppNavigator() {
  return (
    <NavigationContainer>
      <Stack.Navigator
        screenOptions={{
          // Shared element transitions for smoother UX
          ...TransitionPresets.SlideFromRightIOS,
          // Faster transition animations
          transitionSpec: {
            open: { animation: 'timing', config: { duration: 300 } },
            close: { animation: 'timing', config: { duration: 300 } },
          },
          // Keep screen in memory when navigating away
          detachPreviousScreen: false,
        }}
      >
        <Stack.Screen name="Home" component={HomeScreen} />
        <Stack.Screen name="Details" component={DetailsScreen} />
      </Stack.Navigator>
    </NavigationContainer>
  );
}
```

