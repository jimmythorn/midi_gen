## 📊 Performance Measurement & Validation

### Web Performance Measurement

```tsx
// Component with performance monitoring
import { useCallback, useState } from 'react';
import { Profiler } from 'react';

function onRenderCallback(
  id, // the "id" prop of the Profiler tree
  phase, // "mount" or "update"
  actualDuration, // time spent rendering
  baseDuration, // estimated time for entire subtree
  startTime, // when React began rendering
  commitTime // when React committed changes
) {
  // Log or send to analytics
  console.log(`${id} took ${actualDuration}ms to ${phase}`);
  
  // Alert on slow renders in development
  if (process.env.NODE_ENV === 'development' && actualDuration > 10) {
    console.warn(`Slow render detected: ${id} took ${actualDuration}ms`);
  }
}

function ProfiledComponent() {
  return (
    <Profiler id="MyComponent" onRender={onRenderCallback}>
      <ExpensiveComponent />
    </Profiler>
  );
}
```

### Native Performance Measurement

```tsx
// React Native performance monitoring
import { InteractionManager } from 'react-native';

function trackInteraction() {
  const start = Date.now();
  
  // Create a tracked interaction
  const handle = InteractionManager.createInteractionHandle();
  
  // Perform work
  expensiveOperation();
  
  // Complete the interaction
  InteractionManager.clearInteractionHandle(handle);
  
  console.log(`Operation took: ${Date.now() - start}ms`);
}

// Monitor JS frame rate
const frameCount = 0;
const startTime = Date.now();

const checkFrameRate = () => {
  frameCount++;
  const elapsed = Date.now() - startTime;
  if (elapsed > 1000) {
    const fps = Math.round((frameCount * 1000) / elapsed);
    console.log(`Current frame rate: ${fps}fps`);
    
    if (fps < 55) {
      console.warn('Frame rate below target 60fps');
    }
    
    frameCount = 0;
    startTime = Date.now();
  }
  requestAnimationFrame(checkFrameRate);
};

requestAnimationFrame(checkFrameRate);
```

