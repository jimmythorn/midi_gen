## 🌍 Web-Specific Optimizations

### 1. React 18 Concurrent Features

```tsx
// Using startTransition for non-urgent updates
import { startTransition } from 'react';

function SearchResults() {
  const [query, setQuery] = useState('');
  const [results, setResults] = useState([]);
  
  const handleSearch = (e) => {
    // Update the input immediately
    setQuery(e.target.value);
    
    // Mark results update as non-urgent
    startTransition(() => {
      // This update can be interrupted
      setResults(searchData(e.target.value));
    });
  };
  
  return (
    <div>
      <input value={query} onChange={handleSearch} />
      {/* Show loading UI during transition */}
      <div className={isPending ? 'dimmed' : ''}>
        {results.map(result => (
          <ResultItem key={result.id} data={result} />
        ))}
      </div>
    </div>
  );
}
```

### 2. Web Asset Optimization

```tsx
// Use next-gen image formats with responsive sizing
function ProductImage({ product }) {
  return (
    <picture>
      <source 
        srcSet={product.imageWebp} 
        type="image/webp" 
        media="(min-width: 800px)"
      />
      <source 
        srcSet={product.imageSm} 
        media="(max-width: 799px)"
      />
      <img 
        src={product.image} 
        alt={product.name}
        loading="lazy" // Native lazy loading
        width="300"
        height="200"
      />
    </picture>
  );
}

// Load non-critical CSS asynchronously
function loadStylesheet(url) {
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = url;
  document.head.appendChild(link);
}

// After critical content loads
if (typeof window !== 'undefined') {
  window.addEventListener('load', () => {
    requestIdleCallback(() => {
      loadStylesheet('/non-critical-styles.css');
    });
  });
}
```

### 3. DOM Optimizations

```tsx
// Batch DOM changes
function UpdateMultipleElements() {
  const updateDomBatch = () => {
    // React 18 already batches these
    setName(newName);
    setEmail(newEmail);
    setPhone(newPhone);
    
    // For legacy DOM operations outside React:
    requestAnimationFrame(() => {
      element1.style.height = '100px';
      element2.className = 'updated';
      element3.textContent = 'New content';
    });
  };
}

// Use CSS transforms for animations
// ❌ Avoid: Changing width/height/left/top
// ✅ Prefer: transform and opacity

const styles = {
  animatedElement: {
    transform: 'translateX(10px) scale(1.1)',
    transition: 'transform 150ms ease-out',
    willChange: 'transform' // For browsers that support it
  }
};
```

