## 🔍 Common Performance Issues & Solutions

### Problem: Excessive Re-renders

<table>
<tr>
<th>Issue</th>
<th>Solution</th>
</tr>
<tr>
<td>

```tsx
// ❌ Problem: Re-renders on every parent update
function ExpensiveComponent({ data, onAction }) {
  // Recalculates on every render
  const processedData = complexProcessing(data);
  
  return (
    <div>
      {processedData.map(item => (
        // New function created every render
        <Item key={item.id} onClick={() => onAction(item.id)} />
      ))}
    </div>
  );
}
```

</td>
<td>

```tsx
// ✅ Solution: Memoization & stable callbacks
function OptimizedComponent({ data, onAction }) {
  // Memoize expensive calculations
  const processedData = useMemo(() => {
    return complexProcessing(data);
  }, [data]);
  
  // Stable callback reference
  const handleItemAction = useCallback((id) => {
    onAction(id);
  }, [onAction]);
  
  return (
    <div>
      {processedData.map(item => (
        <Item 
          key={item.id} 
          onClick={handleItemAction} 
          id={item.id}
        />
      ))}
    </div>
  );
}

// Add memo for pure components
const Item = React.memo(({ id, onClick }) => {
  return <div onClick={() => onClick(id)}>Item {id}</div>
});
```

